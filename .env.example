# Use localhost/127.0.0.1 for this computer or the server's LAN address for LAN play.
GAME_HOST=localhost
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443

# Parent of Data/, not Data/ itself. Needs room for both the zip and extracted MPQs.
WOW_DATA_DIR=./wow-data

# Optional direct zip URL containing Data/*.MPQ:
# WOW_DATA_URL=https://your-mirror.example/client.zip
